# Copy to $env:ProgramData\CpuMiner\config.env (Install.ps1 does this).
# PAYOUT_COIN and WALLET must match.
# The default public address is in config\wallet.txt (committed).
# This placeholder is replaced by Install.ps1 with that address.
PAYOUT_COIN=LTC
WALLET=REPLACE_WITH_LTC_ADDRESS

POOL=stratum+ssl://rx.unmineable.com:443
POOL_WORKER=HomePC
API_PORT=18080
MAX_THREADS=100
DONATE_LEVEL=0

# Conservative home-PC heat limits.
STOP_TEMP=75
RESUME_TEMP=65
TEMP_REQUIRED=true
LHM_URL=http://127.0.0.1:8085/data.json

RESTART_MINUTES=45
WATCHDOG_SECONDS=180
TEMP_SECONDS=60

# Start mining at every login, even if it was manually stopped before shutdown.
# Set to false to restore "resume only if it was active" behaviour.
AUTO_START_ON_LOGIN=true
